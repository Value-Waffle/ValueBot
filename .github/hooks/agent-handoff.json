{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 .github/hooks/scripts/guard-commands.py",
        "timeout": 10
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "python3 .github/hooks/scripts/inject-contract.py",
        "timeout": 10
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "python3 .github/hooks/scripts/check-reports.py",
        "timeout": 10
      }
    ]
  }
}
