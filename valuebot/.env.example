# valuebot v2 environment. Values in mcp.json win at runtime.
# SEC User-Agent is configured once with ./setup.sh <email>
# (writes ${PLUGIN_DATA}/identity.json). The variable below is an optional
# per-run override for CI and probes; leave it empty in normal use.
SEC_USER_AGENT=
EDGAR_RATE_LIMIT_PER_SEC=5
EDGAR_HTTP_TIMEOUT=30
EDGAR_LOCAL_DATA_DIR=${PLUGIN_DATA}/edgar

PLUGIN_DATA=~/.valuebot
VW_THESIS_ROOT=/vw-data/theses
VW_MAX_HTML_MB=40
VW_MAX_FACTS_COMPANIES=100
VW_ENABLE_PRICE=0

# Optional overrides (defaults follow PLUGIN_DATA)
# VW_FUND_CACHE=${PLUGIN_DATA}/modules/fundamentals/cache.sqlite
# VW_ANALYSIS_CACHE=${PLUGIN_DATA}/modules/analysis/cache.sqlite
# VW_REPORTS_DB=${PLUGIN_DATA}/modules/reports/manifest.sqlite
# VW_REPORTS_ARTIFACTS=${PLUGIN_DATA}/modules/reports/artifacts
# VW_THESIS_INDEX=${PLUGIN_DATA}/modules/thesis/index.sqlite

UV_PROJECT_ENVIRONMENT=${PLUGIN_DATA}/uv-env
UV_CACHE_DIR=${PLUGIN_DATA}/uv-cache
UV_PYTHON_INSTALL_DIR=${PLUGIN_DATA}/uv-python
